# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=30d
FRONTEND_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://localhost:27017/tripnest

# Cloudinary Credentials (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (Payments Integration)
# Use 'rzp_test_mockkey' and 'rzp_test_mocksecret' for sandbox simulation
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=rzp_test_mocksecret

# Nodemailer Configuration (Emails)
# Leave blank to fallback to a mock ethereal.email test server
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_address@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=support@tripnest.com

# Gemini AI API Configuration (Trip Planner & Chat)
# Leave blank to run local rule-based heuristics planner
GEMINI_API_KEY=your_google_gemini_api_key
